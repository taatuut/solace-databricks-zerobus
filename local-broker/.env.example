# Copy to .env and fill in real values. All values here are placeholders --
# do not commit a real .env file.

# --- Local broker ---
LOCAL_SEMP_HOST=http://localhost:8080
LOCAL_SEMP_USER=admin
LOCAL_SEMP_PASSWORD=admin
LOCAL_SMF_HOST=localhost:55554
LOCAL_WEB_MESSAGING_URL=ws://localhost:8008
LOCAL_MSG_VPN=zerobus-demo

# --- Publisher identity (used by demo-apps/publisher.py) ---
PUBLISHER_USER=pub-zerobus
PUBLISHER_PASSWORD=CHANGEME_publisher_password

# --- Consumer identity (used by the Zerobus Micro-Integration) ---
CONSUMER_USER=sub-zerobus
CONSUMER_PASSWORD=CHANGEME_consumer_password

# --- Queue the Zerobus Micro-Integration reads from ---
ZEROBUS_QUEUE_NAME=q-zerobus-ingest
ZEROBUS_TOPIC_SUBSCRIPTION='zerobus-demo/sensor/>'
