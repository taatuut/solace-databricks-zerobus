# Copy to .env and fill in real values. Never commit the real .env file.
# Referenced from application.yml as ${VAR_NAME:default} and passed into
# the container via docker-compose.yml's env_file.

SOLACE_SMF_HOST=tcp://host.docker.internal:55554
SOLACE_MSG_VPN=zerobus-demo
SOLACE_CLIENT_USERNAME=CHANGEME
SOLACE_CLIENT_PASSWORD=CHANGEME
SOLACE_QUEUE_NAME=q-zerobus-ingest

DATABRICKS_URL=https://CHANGEME.cloud.databricks.com
DATABRICKS_SERVER_ENDPOINT=CHANGEME
DATABRICKS_CLIENT_ID=CHANGEME
DATABRICKS_CLIENT_SECRET=CHANGEME
DATABRICKS_CATALOG=CHANGEME
DATABRICKS_SCHEMA=CHANGEME
DATABRICKS_TABLE=CHANGEME

# --- Management / Actuator (port 8090 in the container) ---
# Basic-auth user for GET /actuator/health. Without a user every request
# returns HTTP 401. A user with no roles is read-only.
SOLACE_CONNECTOR_SECURITY_USERS_0_NAME=health
SOLACE_CONNECTOR_SECURITY_USERS_0_PASSWORD=CHANGEME
