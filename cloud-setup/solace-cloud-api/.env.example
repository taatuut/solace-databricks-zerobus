# Copy to .env and fill in the real value. Never commit the real .env file.
# Token: Solace Cloud Console > user menu > Token Management > Create Token.
# Permissions: read/create services, and micro_integrations:*:* (see
# ../README.md).
SOLACE_CLOUD_API_TOKEN=CHANGEME_bearer_token
# Must match the Home Cloud region of the organization that owns the token
# (a token used against another region gets 401 "Your permissions have
# changed"). Options:
#   US East: https://api.solace.cloud/api/v2
#   EU:      https://api.solacecloud.eu/api/v2
#   AU:      https://api.solacecloud.com.au/api/v2
#   SG:      https://api.solacecloud.sg/api/v2
SOLACE_CLOUD_API_BASE=https://api.solace.cloud/api/v2
